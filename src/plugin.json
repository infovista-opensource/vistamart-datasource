{
  "type": "datasource",
  "name": "Infovista Ativa Net",
  "id": "infovista-ativanet-datasource",
  "includes": [
    {
      "type": "dashboard",
      "name": "Datacenter health - Demo",
      "path": "dashboards/datacenter_health.json"
    },
    {
      "type": "dashboard",
      "name": "End to End Utilization - Demo",
      "path": "dashboards/endtoend_utilization.json"
    },
    {
      "type": "dashboard",
      "name": "Interface Utilization Overview (multiple) - Demo",
      "path": "dashboards/interface_utilization (multiple).json"
    },
    {
      "type": "dashboard",
      "name": "Interface Utilization Overview (repeat mode) - Demo",
      "path": "dashboards/interface_utilization (repeat mode).json"
    },
    {
      "type": "dashboard",
      "name": "Interface Utilization Overview - Demo",
      "path": "dashboards/interface_utilization.json"
    }
  ],
  "metrics": true,
  "annotations": true,
  "info": {
    "description": "Datasource for Infovista Ativa Net version 26.1",
    "author": {
      "name": "Infovista",
      "url": "https://www.infovista.com"
    },
    "keywords": [
      "infovista",
      "ativanet",
      "plugin"
    ],
    "logos": {
      "small": "images/logo.svg",
      "large": "images/logo.svg"
    },
    "screenshots": [
      {
        "name": "Datasource configuration",
        "path": "images/datasource.png"
      },
      {
        "name": "Query parameters",
        "path": "images/parameters.png"
      },
      {
        "name": "Variable editor",
        "path": "images/variables_editor.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/infovista/vistamart-datasource"
      },
      {
        "name": "License",
        "url": "https://github.com/infovista/vistamart-datasource/blob/main/LICENSE"
      },
      {
        "name": "Change Log",
        "url": "https://github.com/infovista/vistamart-datasource/blob/main/CHANGELOG.md"
      }
    ]
  },
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  },
  "routes": [
    {
      "path": "ativanet/api",
      "url": "{{ .JsonData.url }}",
      "tokenAuth": {
        "url": "{{ .JsonData.urlRoot }}/auth/realms/{{ .JsonData.realm }}/protocol/openid-connect/token",
        "params": {
          "grant_type": "client_credentials",
          "client_id": "{{ .JsonData.clientId }}",
          "client_secret": "{{ .SecureJsonData.clientSecret }}"
        }
      }
    }
  ]
}
